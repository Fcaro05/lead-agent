# ─── Google Places (New Places API v1) ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ─── Firecrawl ──────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ─── Google PageSpeed Insights ──────────────────────────────────────────────────
PAGESPEED_API_KEY=

# ─── OpenAI (gpt-4o-mini) ───────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Google Sheet ───────────────────────────────────────────────────────────────
# ID del Google Sheet (dalla URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=

# ─── Google Service Account (per Sheets) ────────────────────────────────────────
# Ricordati di condividere il Google Sheet con GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ─── Gmail OAuth2 (FASE 2 — opzionale in FASE 1) ────────────────────────────────
# Solo per creare bozze. MAI per inviare email automaticamente.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
